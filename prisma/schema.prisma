generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// Catálogo de Roles
// -------------------------------------------------------------
model Role {
  id               String           @id @default(uuid()) @db.VarChar(36)
  name             String           @unique @db.VarChar(50)
  default_path     String?          @default("/") @db.VarChar(100)

  // Auditoría obligatoria (Regla de Oro bdAgent)
  created_at       DateTime         @default(now()) @db.DateTime(3)
  updated_at       DateTime         @updatedAt @db.DateTime(3)
  created_by       String?          @db.VarChar(36)
  updated_by       String?          @db.VarChar(36)

  // Relaciones N:M
  user_roles       UserRole[]
  role_permissions RolePermission[]

  @@map("roles")
}

// -------------------------------------------------------------
// Catálogo de Permisos
// -------------------------------------------------------------
model Permission {
  id               String           @id @default(uuid()) @db.VarChar(36)
  slug             String           @unique @db.VarChar(60)
  name             String           @db.VarChar(75)
  module           String           @db.VarChar(50)
  description      String?          @db.VarChar(255)

  // Auditoría obligatoria (Regla de Oro bdAgent)
  created_at       DateTime         @default(now()) @db.DateTime(3)
  updated_at       DateTime         @updatedAt @db.DateTime(3)
  created_by       String?          @db.VarChar(36)
  updated_by       String?          @db.VarChar(36)

  // Relaciones N:M
  role_permissions RolePermission[]

  @@map("permissions")
}

// -------------------------------------------------------------
// Tabla Puente: Roles ↔ Permisos (N:M)
// -------------------------------------------------------------
model RolePermission {
  id            String     @id @default(uuid()) @db.VarChar(36)
  role_id       String     @db.VarChar(36)
  permission_id String     @db.VarChar(36)

  // Auditoría obligatoria (Regla de Oro bdAgent)
  created_at    DateTime   @default(now()) @db.DateTime(3)
  updated_at    DateTime   @updatedAt @db.DateTime(3)
  created_by    String?    @db.VarChar(36)
  updated_by    String?    @db.VarChar(36)

  // Relaciones
  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id], map: "role_permission_unique")
  @@index([permission_id], map: "role_permissions_permission_id_fkey")
  @@map("role_permissions")
}

// -------------------------------------------------------------
// Catálogo de Usuarios
// -------------------------------------------------------------
model User {
  id            String       @id @default(uuid()) @db.VarChar(36)
  name          String       @db.VarChar(75)
  user          String       @unique @db.VarChar(50)
  email         String?      @unique @db.VarChar(75)
  password_hash String       @db.VarChar(255)
  pin_code      String?      @db.Char(4)
  is_active     Boolean      @default(true)

  // Auditoría obligatoria (Regla de Oro bdAgent)
  created_at    DateTime     @default(now()) @db.DateTime(3)
  updated_at    DateTime     @updatedAt @db.DateTime(3)
  created_by    String?      @db.VarChar(36)
  updated_by    String?      @db.VarChar(36)

  // Relaciones N:M (Un usuario tiene uno o más roles)
  user_roles    UserRole[]

  @@map("users")
}

// -------------------------------------------------------------
// Tabla Puente: Usuarios ↔ Roles (N:M)
// -------------------------------------------------------------
model UserRole {
  id         String   @id @default(uuid()) @db.VarChar(36)
  user_id    String   @db.VarChar(36)
  role_id    String   @db.VarChar(36)

  // Auditoría obligatoria (Regla de Oro bdAgent)
  created_at DateTime @default(now()) @db.DateTime(3)
  updated_at DateTime @updatedAt @db.DateTime(3)
  created_by String?  @db.VarChar(36)
  updated_by String?  @db.VarChar(36)

  // Relaciones
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [role_id], references: [id], onDelete: Restrict)

  @@unique([user_id, role_id], map: "user_role_unique")
  @@index([role_id], map: "user_roles_role_id_fkey")
  @@map("user_roles")
}

// -------------------------------------------------------------
// Configuración del Sistema e Información de la Empresa
// -------------------------------------------------------------
model SystemSetting {
  id              String   @id @default(uuid()) @db.VarChar(36)
  company_name    String   @default("Mi Restaurante") @db.VarChar(120)
  tax_id          String?  @db.VarChar(50)
  phone           String?  @db.VarChar(50)
  email           String?  @db.VarChar(100)
  address         String?  @db.VarChar(255)
  currency_symbol String   @default("$") @db.VarChar(10)
  logo_url        String?  @db.VarChar(255)

  // Auditoría obligatoria (Regla de Oro bdAgent)
  created_at      DateTime @default(now()) @db.DateTime(3)
  updated_at      DateTime @updatedAt @db.DateTime(3)
  created_by      String?  @db.VarChar(36)
  updated_by      String?  @db.VarChar(36)

  @@map("system_settings")
}

// -------------------------------------------------------------
// Bitácora de Copias de Seguridad (Backups)
// -------------------------------------------------------------
model BackupLog {
  id                     String   @id @default(uuid()) @db.VarChar(36)
  filename               String   @db.VarChar(255)
  file_path              String   @db.VarChar(500)
  file_size_bytes        Int      @default(0)
  file_size_formatted    String   @db.VarChar(50)
  custom_destination     String?  @db.VarChar(500)
  user_name              String   @db.VarChar(100)
  user_login             String   @db.VarChar(50)

  // Auditoría obligatoria (Regla de Oro bdAgent)
  created_at             DateTime @default(now()) @db.DateTime(3)
  updated_at             DateTime @updatedAt @db.DateTime(3)
  created_by             String?  @db.VarChar(36)
  updated_by             String?  @db.VarChar(36)

  @@index([created_at], map: "backup_logs_created_at_idx")
  @@index([created_by], map: "backup_logs_created_by_idx")
  @@map("backup_logs")
}

// -------------------------------------------------------------
// Bitácora de Restauración de Base de Datos
// -------------------------------------------------------------
model RestoreLog {
  id                     String   @id @default(uuid()) @db.VarChar(36)
  imported_filename      String   @db.VarChar(255)
  file_size_bytes        Int      @default(0)
  file_size_formatted    String   @db.VarChar(50)
  auto_backup_filename   String   @db.VarChar(255)
  status                 String   @default("SUCCESS") @db.VarChar(20)
  error_message          String?  @db.Text
  user_name              String   @db.VarChar(100)
  user_login             String   @db.VarChar(50)

  // Auditoría obligatoria (Regla de Oro bdAgent)
  created_at             DateTime @default(now()) @db.DateTime(3)
  updated_at             DateTime @updatedAt @db.DateTime(3)
  created_by             String?  @db.VarChar(36)
  updated_by             String?  @db.VarChar(36)

  @@index([created_at], map: "restore_logs_created_at_idx")
  @@index([created_by], map: "restore_logs_created_by_idx")
  @@map("restore_logs")
}

// -------------------------------------------------------------
// Catálogo de Áreas del Restaurante
// -------------------------------------------------------------
model Area {
  id         String            @id @default(uuid()) @db.VarChar(36)
  name       String            @unique @db.VarChar(50)

  // Auditoría obligatoria (Regla de Oro bdAgent)
  created_at DateTime          @default(now()) @db.DateTime(3)
  updated_at DateTime          @updatedAt @db.DateTime(3)
  created_by String?           @db.VarChar(36)
  updated_by String?           @db.VarChar(36)

  // Relación 1:N con Mesas
  tables     RestaurantTable[]

  @@map("areas")
}

// -------------------------------------------------------------
// Catálogo de Mesas / Espacios del Restaurante
// -------------------------------------------------------------
model RestaurantTable {
  id         String   @id @default(uuid()) @db.VarChar(36)
  name       String   @db.VarChar(50)
  area_id    String   @db.VarChar(36)

  // Auditoría obligatoria (Regla de Oro bdAgent)
  created_at DateTime @default(now()) @db.DateTime(3)
  updated_at DateTime @updatedAt @db.DateTime(3)
  created_by String?  @db.VarChar(36)
  updated_by String?  @db.VarChar(36)

  // Relaciones
  area       Area     @relation(fields: [area_id], references: [id], onDelete: Restrict)
  sales      Sale[]

  @@unique([area_id, name], map: "area_table_name_unique")
  @@index([area_id], map: "restaurant_tables_area_id_fkey")
  @@map("restaurant_tables")
}

// -------------------------------------------------------------
// Catálogo de Unidades de Medida
// -------------------------------------------------------------
model MeasurementUnit {
  id         String    @id @default(uuid()) @db.VarChar(36)
  name       String    @db.VarChar(50)
  symbol     String    @unique @db.VarChar(10)

  // Auditoría obligatoria (Regla de Oro bdAgent)
  created_at DateTime  @default(now()) @db.DateTime(3)
  updated_at DateTime  @updatedAt @db.DateTime(3)
  created_by String?   @db.VarChar(36)
  updated_by String?   @db.VarChar(36)

  // Relaciones
  products   Product[]

  @@map("measurement_units")
}

// -------------------------------------------------------------
// Catálogo de Categorías de Productos
// -------------------------------------------------------------
model Category {
  id          String    @id @default(uuid()) @db.VarChar(36)
  name        String    @unique @db.VarChar(60)
  description String?   @db.VarChar(255)

  // Auditoría obligatoria (Regla de Oro bdAgent)
  created_at  DateTime  @default(now()) @db.DateTime(3)
  updated_at  DateTime  @updatedAt @db.DateTime(3)
  created_by  String?   @db.VarChar(36)
  updated_by  String?   @db.VarChar(36)

  // Relaciones
  products    Product[]

  @@map("categories")
}

// -------------------------------------------------------------
// Catálogo de Marcas / Fabricantes
// -------------------------------------------------------------
model Brand {
  id          String    @id @default(uuid()) @db.VarChar(36)
  name        String    @unique @db.VarChar(80)
  description String?   @db.VarChar(255)

  // Auditoría obligatoria (Regla de Oro bdAgent)
  created_at  DateTime  @default(now()) @db.DateTime(3)
  updated_at  DateTime  @updatedAt @db.DateTime(3)
  created_by  String?   @db.VarChar(36)
  updated_by  String?   @db.VarChar(36)

  // Relaciones
  products    Product[]

  @@map("brands")
}

// -------------------------------------------------------------
// Catálogo de Productos
// -------------------------------------------------------------
model Product {
  id              String                        @id @default(uuid()) @db.VarChar(36)
  code            String                        @unique @db.VarChar(30)
  name            String                        @db.VarChar(100)
  brand_id        String?                       @db.VarChar(36)
  category_id     String                        @db.VarChar(36)
  base_unit_id    String                        @db.VarChar(36)
  supplier_id     String?                       @db.VarChar(36)
  product_type    String                        @default("DIRECT_SALE") @db.VarChar(25) // DIRECT_SALE, MANUFACTURED, RAW_MATERIAL, SUB_RECIPE, ON_DEMAND
  sale_price      Decimal                       @default(0.00) @db.Decimal(10, 2)
  current_cost    Decimal                       @default(0.00) @db.Decimal(10, 2)
  current_stock   Decimal                       @default(0.00) @db.Decimal(10, 2)
  min_stock_alert Decimal                       @default(5.00) @db.Decimal(10, 2)
  image_url       String?                       @db.VarChar(255)
  is_active       Boolean                       @default(true)

  // Auditoría obligatoria (Regla de Oro bdAgent)
  created_at      DateTime                      @default(now()) @db.DateTime(3)
  updated_at      DateTime                      @updatedAt @db.DateTime(3)
  created_by      String?                       @db.VarChar(36)
  updated_by      String?                       @db.VarChar(36)

  // Relaciones
  brand           Brand?                        @relation(fields: [brand_id], references: [id], onDelete: Restrict)
  category        Category                      @relation(fields: [category_id], references: [id], onDelete: Restrict)
  base_unit       MeasurementUnit               @relation(fields: [base_unit_id], references: [id], onDelete: Restrict)
  supplier        Supplier?                     @relation(fields: [supplier_id], references: [id], onDelete: SetNull)
  presentations   ProductPurchasePresentation[]

  // Relaciones de Recetas y Producción
  recipes_as_final     Recipe[]               @relation("ProductRecipe")
  as_ingredient        RecipeItem[]           @relation("IngredientProduct")
  production_batches   ProductionBatch[]      @relation("BatchProduct")
  consumed_batch_items ProductionBatchItem[]  @relation("BatchItemIngredient")
  stock_entry_items    StockEntryItem[]
  sale_items           SaleItem[]

  @@index([brand_id], map: "products_brand_id_fkey")
  @@index([category_id], map: "products_category_id_fkey")
  @@index([base_unit_id], map: "products_base_unit_id_fkey")
  @@index([supplier_id], map: "products_supplier_id_fkey")
  @@map("products")
}

// -------------------------------------------------------------
// Catálogo de Proveedores
// -------------------------------------------------------------
model Supplier {
  id           String    @id @default(uuid()) @db.VarChar(36)
  name         String    @unique @db.VarChar(100)
  contact_name String?   @db.VarChar(100)
  phone        String?   @db.VarChar(50)
  email        String?   @db.VarChar(100)
  address      String?   @db.VarChar(255)
  category     String    @default("GENERAL") @db.VarChar(50) // FRUTAS, PANADERIA, CARNICERIA, ABARROTES, GENERAL
  is_active    Boolean   @default(true)

  // Auditoría obligatoria (Regla de Oro bdAgent)
  created_at   DateTime  @default(now()) @db.DateTime(3)
  updated_at   DateTime  @updatedAt @db.DateTime(3)
  created_by   String?   @db.VarChar(36)
  updated_by   String?   @db.VarChar(36)

  // Relaciones
  products      Product[]
  stock_entries StockEntry[]

  @@map("suppliers")
}

// -------------------------------------------------------------
// Catálogo de Recetas y Fórmulas de Producción
// -------------------------------------------------------------
model Recipe {
  id                 String            @id @default(uuid()) @db.VarChar(36)
  product_id         String            @db.VarChar(36)
  name               String            @db.VarChar(100)
  recipe_type        String            @default("BATCH_SCALABLE") @db.VarChar(30) // BATCH_SCALABLE, SUB_RECIPE_BATCH, ON_DEMAND_UNIT
  base_yield         Decimal           @default(1.00) @db.Decimal(10, 2)
  yield_unit         String            @default("UND") @db.VarChar(20) // ML, LB, UND, VASO
  instructions       String?           @db.Text
  is_active          Boolean           @default(true)

  // Auditoría obligatoria (Regla de Oro bdAgent)
  created_at         DateTime          @default(now()) @db.DateTime(3)
  updated_at         DateTime          @updatedAt @db.DateTime(3)
  created_by         String?           @db.VarChar(36)
  updated_by         String?           @db.VarChar(36)

  // Relaciones
  product            Product           @relation("ProductRecipe", fields: [product_id], references: [id], onDelete: Cascade)
  items              RecipeItem[]
  production_batches ProductionBatch[]

  @@index([product_id], map: "recipes_product_id_fkey")
  @@map("recipes")
}

// -------------------------------------------------------------
// Ingredientes de la Receta
// -------------------------------------------------------------
model RecipeItem {
  id            String   @id @default(uuid()) @db.VarChar(36)
  recipe_id     String   @db.VarChar(36)
  ingredient_id String   @db.VarChar(36)
  quantity      Decimal  @db.Decimal(10, 4)
  unit          String   @db.VarChar(20)

  // Auditoría obligatoria (Regla de Oro bdAgent)
  created_at    DateTime @default(now()) @db.DateTime(3)
  updated_at    DateTime @updatedAt @db.DateTime(3)
  created_by    String?  @db.VarChar(36)
  updated_by    String?  @db.VarChar(36)

  // Relaciones
  recipe        Recipe   @relation(fields: [recipe_id], references: [id], onDelete: Cascade)
  ingredient    Product  @relation("IngredientProduct", fields: [ingredient_id], references: [id], onDelete: Restrict)

  @@index([recipe_id], map: "recipe_items_recipe_id_fkey")
  @@index([ingredient_id], map: "recipe_items_ingredient_id_fkey")
  @@map("recipe_items")
}

// -------------------------------------------------------------
// Registro de Tandas y Lotes de Producción (Cocina / Barra)
// -------------------------------------------------------------
model ProductionBatch {
  id                        String                @id @default(uuid()) @db.VarChar(36)
  recipe_id                 String                @db.VarChar(36)
  product_id                String                @db.VarChar(36)
  container_capacity_liters Decimal?              @db.Decimal(10, 2) // Capacidad de cubeta (1 a 10L) si aplica
  produced_quantity         Decimal               @db.Decimal(10, 2) // Cantidad obtenida (ML o LB)
  total_cost                Decimal               @default(0.00) @db.Decimal(10, 2)
  notes                     String?               @db.VarChar(255)

  // Auditoría obligatoria (Regla de Oro bdAgent)
  created_at                DateTime              @default(now()) @db.DateTime(3)
  updated_at                DateTime              @updatedAt @db.DateTime(3)
  created_by                String?               @db.VarChar(36)
  updated_by                String?               @db.VarChar(36)

  // Relaciones
  recipe                    Recipe                @relation(fields: [recipe_id], references: [id], onDelete: Restrict)
  product                   Product               @relation("BatchProduct", fields: [product_id], references: [id], onDelete: Restrict)
  consumed_items            ProductionBatchItem[]

  @@index([recipe_id], map: "production_batches_recipe_id_fkey")
  @@index([product_id], map: "production_batches_product_id_fkey")
  @@map("production_batches")
}

// -------------------------------------------------------------
// Detalle de Insumos Consumidos en la Tanda de Producción
// -------------------------------------------------------------
model ProductionBatchItem {
  id                String          @id @default(uuid()) @db.VarChar(36)
  batch_id          String          @db.VarChar(36)
  ingredient_id     String          @db.VarChar(36)
  quantity_consumed Decimal         @db.Decimal(10, 4)
  unit_cost_applied Decimal         @default(0.00) @db.Decimal(10, 2)
  total_cost        Decimal         @default(0.00) @db.Decimal(10, 2)

  // Auditoría obligatoria (Regla de Oro bdAgent)
  created_at        DateTime        @default(now()) @db.DateTime(3)
  updated_at        DateTime        @updatedAt @db.DateTime(3)
  created_by        String?         @db.VarChar(36)
  updated_by        String?         @db.VarChar(36)

  // Relaciones
  batch             ProductionBatch @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  ingredient        Product         @relation("BatchItemIngredient", fields: [ingredient_id], references: [id], onDelete: Restrict)

  @@index([batch_id], map: "production_batch_items_batch_id_fkey")
  @@index([ingredient_id], map: "production_batch_items_ingredient_id_fkey")
  @@map("production_batch_items")
}

// -------------------------------------------------------------
// Presentaciones de Compra y Factores de Conversión
// -------------------------------------------------------------
model ProductPurchasePresentation {
  id                String   @id @default(uuid()) @db.VarChar(36)
  product_id        String   @db.VarChar(36)
  name              String   @db.VarChar(60) // "Caja de 24", "Paquete de 6", "Charola de 20"
  conversion_factor Int      // 24, 12, 6, 20, etc.
  barcode           String?  @db.VarChar(50)
  default_cost      Decimal? @db.Decimal(10, 2) // Precio de compra de esta presentación

  // Auditoría obligatoria (Regla de Oro bdAgent)
  created_at        DateTime @default(now()) @db.DateTime(3)
  updated_at        DateTime @updatedAt @db.DateTime(3)
  created_by        String?  @db.VarChar(36)
  updated_by        String?  @db.VarChar(36)

  // Relaciones
  product           Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([product_id, name], map: "product_presentation_unique")
  @@index([product_id], map: "product_purchase_presentations_product_id_fkey")
  @@map("product_purchase_presentations")
}

// -------------------------------------------------------------
// Registro de Entradas de Almacén y Compras
// -------------------------------------------------------------
model StockEntry {
  id              String             @id @default(uuid()) @db.VarChar(36)
  entry_number    String             @unique @db.VarChar(30) // Ej: "CMP-2026-0001", "ENT-2026-0001"
  supplier_id     String?            @db.VarChar(36)
  entry_type      String             @default("COMPRA") @db.VarChar(20) // "COMPRA", "DONACION", "AJUSTE"
  entry_date      DateTime           @default(now()) @db.DateTime(3) // Fecha de compra/recepción
  invoice_number  String?            @db.VarChar(50) // No. de Factura física o serie del proveedor
  
  // Aspectos Financieros
  payment_type    String             @default("CONTADO") @db.VarChar(20) // "CONTADO", "CREDITO", "NO_APLICA"
  payment_status  String             @default("PAGADA") @db.VarChar(20) // "PAGADA", "PENDIENTE", "PARCIAL", "NO_APLICA"
  total_cost      Decimal            @default(0.00) @db.Decimal(10, 2)
  paid_amount     Decimal            @default(0.00) @db.Decimal(10, 2)
  balance_amount  Decimal            @default(0.00) @db.Decimal(10, 2) // Saldo pendiente
  due_date        DateTime?          @db.Date // Fecha de vencimiento si es a crédito
  notes           String?            @db.Text
  
  // Auditoría obligatoria (Regla de Oro bdAgent)
  created_at      DateTime           @default(now()) @db.DateTime(3)
  updated_at      DateTime           @updatedAt @db.DateTime(3)
  created_by      String?            @db.VarChar(36)
  updated_by      String?            @db.VarChar(36)

  // Relaciones
  supplier        Supplier?          @relation(fields: [supplier_id], references: [id], onDelete: Restrict)
  items           StockEntryItem[]
  payments        PurchasePayment[]

  @@index([supplier_id], map: "stock_entries_supplier_id_fkey")
  @@map("stock_entries")
}

// -------------------------------------------------------------
// Detalle de Ítems / Productos en la Entrada
// -------------------------------------------------------------
model StockEntryItem {
  id                 String             @id @default(uuid()) @db.VarChar(36)
  entry_id           String             @db.VarChar(36)
  product_id         String             @db.VarChar(36)
  presentation_name  String?            @db.VarChar(60) // Ej. "Caja de 24", "Saco 50 lb" o null si unidad base
  quantity           Decimal            @db.Decimal(10, 2) // Cantidad en la presentación comprada
  conversion_factor  Int                @default(1) // Factor a unidad base
  base_quantity      Decimal            @db.Decimal(10, 2) // Cantidad total en unidad base (quantity * conversion_factor)
  unit_cost          Decimal            @db.Decimal(10, 2) // Costo unitario base
  total_cost         Decimal            @db.Decimal(10, 2)
  
  // Auditoría obligatoria (Regla de Oro bdAgent)
  created_at         DateTime           @default(now()) @db.DateTime(3)
  updated_at         DateTime           @updatedAt @db.DateTime(3)
  created_by         String?            @db.VarChar(36)
  updated_by         String?            @db.VarChar(36)

  // Relaciones
  entry              StockEntry         @relation(fields: [entry_id], references: [id], onDelete: Cascade)
  product            Product            @relation(fields: [product_id], references: [id], onDelete: Restrict)

  @@index([entry_id], map: "stock_entry_items_entry_id_fkey")
  @@index([product_id], map: "stock_entry_items_product_id_fkey")
  @@map("stock_entry_items")
}

// -------------------------------------------------------------
// Registro de Pagos y Abonos a Compras
// -------------------------------------------------------------
model PurchasePayment {
  id                 String             @id @default(uuid()) @db.VarChar(36)
  entry_id           String             @db.VarChar(36)
  payment_date       DateTime           @default(now()) @db.DateTime(3)
  amount             Decimal            @db.Decimal(10, 2)
  payment_method     String             @default("EFECTIVO") @db.VarChar(20) // "EFECTIVO", "CHEQUE", "DEPOSITO", "TRANSFERENCIA"
  
  // Datos bancarios (obligatorios si no es EFECTIVO)
  bank_name          String?            @db.VarChar(80) // Nombre del Banco emisor/receptor
  document_number    String?            @db.VarChar(50) // No. de cheque, transferencia o boleta
  document_date      DateTime?          @db.Date // Fecha consignada en el documento bancario
  notes              String?            @db.VarChar(255)
  
  // Auditoría obligatoria (Regla de Oro bdAgent)
  created_at         DateTime           @default(now()) @db.DateTime(3)
  updated_at         DateTime           @updatedAt @db.DateTime(3)
  created_by         String?            @db.VarChar(36)
  updated_by         String?            @db.VarChar(36)

  // Relaciones
  entry              StockEntry         @relation(fields: [entry_id], references: [id], onDelete: Cascade)

  @@index([entry_id], map: "purchase_payments_entry_id_fkey")
  @@map("purchase_payments")
}

// -------------------------------------------------------------
// Registro de Gastos Operativos del Negocio
// -------------------------------------------------------------
model Expense {
  id              String    @id @default(uuid()) @db.VarChar(36)
  expense_number  String    @unique @db.VarChar(30) // Ej. "GAS-2026-0001"
  expense_date    DateTime  @default(now()) @db.DateTime(3)
  category        String    @db.VarChar(50) // PERSONAL_PLANILLA, ENERGIA_ELECTRICA, AGUA_POTABLE, GAS_PROPANO, IMPUESTOS_SAT, ALQUILER, MANTENIMIENTO, DESECHABLES_LIMPIEZA, OTROS
  description     String    @db.VarChar(200)
  amount          Decimal   @db.Decimal(10, 2)
  payment_method  String    @default("EFECTIVO") @db.VarChar(20) // EFECTIVO, CHEQUE, DEPOSITO, TRANSFERENCIA

  // Datos bancarios
  bank_name       String?   @db.VarChar(80)
  document_number String?   @db.VarChar(50)
  document_date   DateTime? @db.Date
  notes           String?   @db.VarChar(255)

  // Auditoría obligatoria (Regla de Oro bdAgent)
  created_at      DateTime  @default(now()) @db.DateTime(3)
  updated_at      DateTime  @updatedAt @db.DateTime(3)
  created_by      String?   @db.VarChar(36)
  updated_by      String?   @db.VarChar(36)

  @@map("expenses")
}

// -------------------------------------------------------------
// Registro de Ventas (Punto de Venta / POS)
// -------------------------------------------------------------
model Sale {
  id              String           @id @default(uuid()) @db.VarChar(36)
  sale_number     String           @unique @db.VarChar(30) // Ej. "VTA-2026-0001"
  sale_date       DateTime         @default(now()) @db.DateTime(3)
  customer_name   String           @default("Consumidor Final") @db.VarChar(100)
  table_id        String?          @db.VarChar(36)
  sale_type       String           @default("DIRECTA") @db.VarChar(20) // DIRECTA, MESA, LLEVAR, DELIVERY
  payment_method  String           @default("EFECTIVO") @db.VarChar(20) // EFECTIVO, TARJETA, TRANSFERENCIA
  bank_name       String?          @db.VarChar(80)
  document_number String?          @db.VarChar(50)
  subtotal        Decimal          @db.Decimal(10, 2)
  total           Decimal          @db.Decimal(10, 2)
  cash_received   Decimal?         @db.Decimal(10, 2)
  change_returned Decimal?         @db.Decimal(10, 2)
  status          String           @default("COMPLETADA") @db.VarChar(20) // COMPLETADA, ANULADA
  notes           String?          @db.VarChar(255)

  // Auditoría obligatoria (Regla de Oro bdAgent)
  created_at      DateTime         @default(now()) @db.DateTime(3)
  updated_at      DateTime         @updatedAt @db.DateTime(3)
  created_by      String?          @db.VarChar(36)
  updated_by      String?          @db.VarChar(36)

  // Relaciones
  table           RestaurantTable? @relation(fields: [table_id], references: [id], onDelete: SetNull)
  items           SaleItem[]

  @@index([table_id], map: "sales_table_id_fkey")
  @@map("sales")
}

// -------------------------------------------------------------
// Detalle de Productos en la Venta
// -------------------------------------------------------------
model SaleItem {
  id              String   @id @default(uuid()) @db.VarChar(36)
  sale_id         String   @db.VarChar(36)
  product_id      String   @db.VarChar(36)
  product_name    String   @db.VarChar(100)
  quantity        Decimal  @db.Decimal(10, 2)
  unit_price      Decimal  @db.Decimal(10, 2)
  subtotal        Decimal  @db.Decimal(10, 2)
  unit_cost       Decimal  @default(0.00) @db.Decimal(10, 2)

  // Auditoría obligatoria (Regla de Oro bdAgent)
  created_at      DateTime @default(now()) @db.DateTime(3)
  updated_at      DateTime @updatedAt @db.DateTime(3)
  created_by      String?  @db.VarChar(36)
  updated_by      String?  @db.VarChar(36)

  // Relaciones
  sale            Sale     @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [product_id], references: [id], onDelete: Restrict)

  @@index([sale_id], map: "sale_items_sale_id_fkey")
  @@index([product_id], map: "sale_items_product_id_fkey")
  @@map("sale_items")
}
